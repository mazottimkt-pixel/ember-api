{
  "name": "ember-comercial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "whatsapp:dev": "node scripts/whatsapp-dev.mjs",
    "whatsapp:dev:check": "node scripts/whatsapp-dev.mjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:inspect": "node scripts/db-inspect.mjs",
    "db:migrate": "node scripts/db-migrate.mjs --apply",
    "db:validate": "node scripts/db-validate.mjs",
    "test:integration": "node scripts/integration-flow.mjs",
    "test:contacts": "node scripts/contact-document-flow.mjs",
    "test:auth-rls:stability": "node scripts/auth-rls-stability.mjs 20",
    "db:seed": "node scripts/seed-demo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "^16.2.12",
    "openai": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
